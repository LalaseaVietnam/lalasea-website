<script>
  // Gửi yêu cầu tư vấn tiệc vào cùng Google Sheet với form đặt bàn.
  // Ghi chú viết tiếng Việt cho nhân viên, kèm dấu "khách tiếng Anh".
  (function () {
    var BOOKING_URL = "{{ thongtin.booking_url }}";
    var form = document.getElementById('event-form');
    var msg = document.getElementById('event-msg');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!BOOKING_URL) {
        msg.style.color = '#c0392b';
        msg.textContent = 'This form is not available right now — please call {{ thongtin.dien_thoai | sdtQuocTe }}.';
        return;
      }
      msg.style.color = '#0b4f6c';
      msg.textContent = 'Sending...';
      var data = Object.fromEntries(new FormData(form).entries());
      data.thoigian = data.ngay || '';
      data.ghichu = 'TƯ VẤN TIỆC [Khách tiếng Anh] — Loại: ' + (data.loai_tiec || '?')
        + (data.ngay ? ' · Ngày dự kiến: ' + data.ngay : '')
        + (data.yeucau ? ' · Yêu cầu: ' + data.yeucau : '');
      fetch(BOOKING_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(data)
      }).then(function () {
        msg.style.color = '#1b9aaa';
        msg.textContent = 'Lalasea has received your details. Our events team will contact you to discuss the details. 🌊';
        form.reset();
      }).catch(function () {
        msg.style.color = '#c0392b';
        msg.textContent = 'Something went wrong. Please call {{ thongtin.dien_thoai | sdtQuocTe }}.';
      });
    });
  })();
</script>
