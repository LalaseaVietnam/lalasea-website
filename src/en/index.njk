<!-- ===== SLIDESHOW + BOOKING SUBMIT ===== -->
<script>
  // Banner tự trượt ảnh
  (function () {
    var slides = document.querySelectorAll('#hero-slides .slide-bg');
    var dots = document.querySelectorAll('#hero-dots button');
    var cur = 0, timer;
    function show(i) {
      slides[cur].classList.remove('active');
      dots[cur].classList.remove('active');
      cur = (i + slides.length) % slides.length;
      slides[cur].classList.add('active');
      dots[cur].classList.add('active');
    }
    function auto() { timer = setInterval(function () { show(cur + 1); }, 5500); }
    dots.forEach(function (d, i) {
      d.addEventListener('click', function () { clearInterval(timer); show(i); auto(); });
    });
    auto();
  })();

  // Gửi đặt bàn vào cùng Google Sheet với bản tiếng Việt. Đánh dấu "[Khách tiếng Anh]"
  // vào ghi chú để nhân viên biết cần trả lời bằng tiếng Anh.
  const BOOKING_URL = "{{ thongtin.booking_url }}";
  const form = document.getElementById('booking-form');
  const msg = document.getElementById('booking-msg');
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (!BOOKING_URL) {
      msg.style.color = '#c0392b';
      msg.textContent = 'Online booking is not available right now — please call {{ thongtin.dien_thoai | sdtQuocTe }}.';
      return;
    }
    msg.style.color = '#0b4f6c';
    msg.textContent = 'Sending...';
    var data = Object.fromEntries(new FormData(form).entries());
    data.ghichu = '[Khách tiếng Anh] ' + (data.ghichu || '');
    fetch(BOOKING_URL, {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(data)
    }).then(function () {
      msg.style.color = '#1b9aaa';
      msg.textContent = 'Request sent! The restaurant will contact you soon. Thank you 🌊';
      form.reset();
    }).catch(function () {
      msg.style.color = '#c0392b';
      msg.textContent = 'Something went wrong. Please call {{ thongtin.dien_thoai | sdtQuocTe }}.';
    });
  });
</script>
