<script>
  // Gửi yêu cầu tư vấn tiệc vào cùng Google Sheet với form đặt bàn
  (function () {
    var BOOKING_URL = "{{ thongtin.booking_url }}";
    var form = document.getElementById('event-form');
    var msg = document.getElementById('event-msg');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!BOOKING_URL) {
        msg.style.color = '#c0392b';
        msg.textContent = 'Form đang tạm nghỉ — vui lòng gọi {{ thongtin.dien_thoai }} giúp mình nhé.';
        return;
      }
      msg.style.color = '#0b4f6c';
      msg.textContent = 'Đang gửi...';
      var data = Object.fromEntries(new FormData(form).entries());
      // Gộp thông tin tiệc vào ghi chú để chắc chắn hiện đủ trong Google Sheet đặt bàn
      data.thoigian = data.ngay || '';
      data.ghichu = 'TƯ VẤN TIỆC — Loại: ' + (data.loai_tiec || '?')
        + (data.ngay ? ' · Ngày dự kiến: ' + data.ngay : '')
        + (data.yeucau ? ' · Yêu cầu: ' + data.yeucau : '');
      fetch(BOOKING_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(data)
      }).then(function () {
        msg.style.color = '#1b9aaa';
        msg.textContent = 'Lalasea đã nhận được thông tin. Đội ngũ phụ trách sẽ liên hệ để tư vấn chi tiết. 🌊';
        form.reset();
      }).catch(function () {
        msg.style.color = '#c0392b';
        msg.textContent = 'Có lỗi khi gửi. Vui lòng gọi {{ thongtin.dien_thoai }} giúp mình nhé.';
      });
    });
  })();
</script>
