<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {%- set tieu_de %}{% if title %}{{ title }} | {{ thongtin.ten }} Hà Tiên{% else %}{{ thongtin.ten }} — Nhà hàng Hải sản Hà Tiên bên biển Tô Châu{% endif %}{% endset %}
  <title>{{ tieu_de | safe }}</title>
  <meta name="description" content="{{ mo_ta or thongtin.mo_ta }}">
  <link rel="canonical" href="{{ thongtin.site_url }}{{ page.url }}">
  {%- if khong_index %}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
  <meta property="og:title" content="{{ tieu_de | safe }}">
  <meta property="og:description" content="{{ mo_ta or thongtin.mo_ta }}">
  <meta property="og:image" content="{{ thongtin.site_url }}{{ anh_dai_dien or '/hero.jpg' }}">
  <meta property="og:url" content="{{ thongtin.site_url }}{{ page.url }}">
  <meta property="og:type" content="{{ og_type or 'website' }}">
  <meta property="og:site_name" content="{{ thongtin.ten }}">
  <meta property="og:locale" content="vi_VN">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <script>document.documentElement.classList.add('js');</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Pacifico&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Restaurant",
    "name": "{{ thongtin.ten }}",
    "alternateName": "Lalasea Bistro Hà Tiên",
    "description": "{{ thongtin.mo_ta }}",
    "servesCuisine": ["Hải sản", "Ẩm thực Việt Nam", "Đồ nướng", "Lẩu"],
    "priceRange": "50.000đ – 500.000đ",
    "telephone": "+84{{ thongtin.dien_thoai_goi | replace('0', '', 1) }}",
    "address": { "@type": "PostalAddress", "streetAddress": "QL80, Tô Châu", "addressLocality": "Hà Tiên", "addressRegion": "An Giang", "addressCountry": "VN" },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "09:00", "closes": "23:00"
    },
    "acceptsReservations": "True",
    "hasMenu": "{{ thongtin.site_url }}/thuc-don/",
    "url": "{{ thongtin.site_url }}/",
    "image": "{{ thongtin.site_url }}/hero.jpg",
    "sameAs": ["{{ thongtin.facebook }}", "{{ thongtin.tiktok }}"]
  }
  </script>
</head>
<body>

  {# Logo Lalasea — định nghĩa một lần, dùng lại nhiều chỗ #}
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="lalasea-logo" viewBox="0 0 220 450">
      {# Khung viên thuốc — thành hai bên hở đúng chỗ tia nắng dài xuyên qua #}
      <g fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round">
        <path d="M 35 130 A 75 75 0 0 1 185 130"/>
        <path d="M 185 130 L 185 177 M 185 193 L 185 280"/>
        <path d="M 185 280 A 75 75 0 0 1 35 280"/>
        <path d="M 35 280 L 35 193 M 35 177 L 35 130"/>
        <path d="M 20 140 L 20 280 A 90 90 0 0 0 200 280 L 200 140"/>
      </g>
      {# Mặt trời — tia dài ngắn xen kẽ, tia ngang dài xuyên thủng khung #}
      <g fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round">
        <circle cx="110" cy="185" r="9" stroke-width="4"/>
        <line x1="110" y1="169" x2="110" y2="117"/>
        <line x1="110" y1="169" x2="110" y2="145" transform="rotate(22.5 110 185)"/>
        <line x1="110" y1="169" x2="110" y2="115" transform="rotate(45 110 185)"/>
        <line x1="110" y1="169" x2="110" y2="145" transform="rotate(67.5 110 185)"/>
        <line x1="110" y1="169" x2="110" y2="97" transform="rotate(90 110 185)"/>
        <line x1="110" y1="169" x2="110" y2="145" transform="rotate(112.5 110 185)"/>
        <line x1="110" y1="169" x2="110" y2="115" transform="rotate(135 110 185)"/>
        <line x1="110" y1="169" x2="110" y2="145" transform="rotate(157.5 110 185)"/>
        <line x1="110" y1="169" x2="110" y2="127" transform="rotate(180 110 185)"/>
        <line x1="110" y1="169" x2="110" y2="145" transform="rotate(202.5 110 185)"/>
        <line x1="110" y1="169" x2="110" y2="115" transform="rotate(225 110 185)"/>
        <line x1="110" y1="169" x2="110" y2="145" transform="rotate(247.5 110 185)"/>
        <line x1="110" y1="169" x2="110" y2="97" transform="rotate(270 110 185)"/>
        <line x1="110" y1="169" x2="110" y2="145" transform="rotate(292.5 110 185)"/>
        <line x1="110" y1="169" x2="110" y2="115" transform="rotate(315 110 185)"/>
        <line x1="110" y1="169" x2="110" y2="145" transform="rotate(337.5 110 185)"/>
      </g>
      {# Chấm trang trí nhỏ quanh mặt trời #}
      <circle cx="80" cy="139" r="2.2" fill="currentColor"/>
      <circle cx="141" cy="232" r="2.2" fill="currentColor"/>
      {# Sóng biển 6 lớp, thu hẹp dần theo đáy khung #}
      <g fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round">
        <path d="M 44 258 q 11 -9 22 0 t 22 0 t 22 0 t 22 0 t 22 0 t 22 0"/>
        <path d="M 44 274 q 11 -9 22 0 t 22 0 t 22 0 t 22 0 t 22 0 t 22 0"/>
        <path d="M 44 290 q 11 -9 22 0 t 22 0 t 22 0 t 22 0 t 22 0 t 22 0"/>
        <path d="M 55 306 q 11 -9 22 0 t 22 0 t 22 0 t 22 0 t 22 0"/>
        <path d="M 56 322 q 10.8 -9 21.6 0 t 21.6 0 t 21.6 0 t 21.6 0 t 21.6 0"/>
        <path d="M 70 338 q 10 -8 20 0 t 20 0 t 20 0 t 20 0"/>
      </g>
      {# Chữ LALASEA cong ôm vòm — chữ to, đặt và xoay từng chữ #}
      <g font-family="'Playfair Display', Georgia, serif" font-size="27" font-weight="700" fill="currentColor" text-anchor="middle">
        <text x="110" y="36" transform="rotate(-62 110 130)">L</text>
        <text x="110" y="36" transform="rotate(-41.3 110 130)">A</text>
        <text x="110" y="36" transform="rotate(-20.7 110 130)">L</text>
        <text x="110" y="36" transform="rotate(0 110 130)">A</text>
        <text x="110" y="36" transform="rotate(20.7 110 130)">S</text>
        <text x="110" y="36" transform="rotate(41.3 110 130)">E</text>
        <text x="110" y="36" transform="rotate(62 110 130)">A</text>
      </g>
      <text x="110" y="437" text-anchor="middle" font-family="'Playfair Display', Georgia, serif" font-size="40" letter-spacing="7" fill="currentColor">BISTRO</text>
    </symbol>
  </svg>

  <header class="site-header">
    <nav class="site-nav">
      <a href="/" class="brand" aria-label="Lalasea Bistro — Trang chủ">
        <svg class="logo-svg" width="26" height="53"><use href="#lalasea-logo"/></svg>
        <span class="wordmark">LALASEA <span>BISTRO</span></span>
      </a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Mở menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <div class="nav-links" id="nav-links">
        <a href="/">Trang chủ</a>
        <a href="/#gioi-thieu">Giới thiệu</a>
        <a href="/thuc-don/">Thực đơn</a>
        <a href="/glamping/">Glamping</a>
        <a href="/tin-tuc/">Tin tức</a>
        <a href="/lien-he/">Liên hệ</a>
        <a href="/#dat-ban" class="btn btn-nav">Đặt bàn</a>
      </div>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  {% if not an_footer %}
  <footer class="site-footer">
    <svg class="logo-svg" width="44" height="90"><use href="#lalasea-logo"/></svg>
    <div class="socials">
      <a href="{{ thongtin.facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5H17V3.6c-.3 0-1.3-.1-2.45-.1-2.4 0-4.05 1.5-4.05 4.2v2.2H7.8V13h2.7v8h3z"/></svg>
      </a>
      <a href="{{ thongtin.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M16.5 3c.3 2 1.6 3.5 3.5 3.8v2.6c-1.3 0-2.5-.4-3.5-1v6.1c0 3.3-2.4 5.5-5.4 5.5A5.3 5.3 0 0 1 6 14.5c0-3 2.4-5.3 5.6-5V12a2.7 2.7 0 0 0-.6-.1 2.7 2.7 0 1 0 2.7 2.7V3h2.8z"/></svg>
      </a>
      <a href="{{ thongtin.zalo }}" target="_blank" rel="noopener" aria-label="Zalo">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2C6.5 2 2 5.9 2 10.7c0 2.6 1.3 4.9 3.4 6.5-.1.8-.5 2.2-1.4 3.3-.2.2 0 .6.3.5 1.9-.3 3.5-1.1 4.4-1.7.4.1 2.1.4 3.3.4 5.5 0 10-3.9 10-8.7S17.5 2 12 2zM7.9 13.5H5.2c-.3 0-.5-.2-.5-.5s.1-.5.3-.7l2.3-3h-2c-.3 0-.5-.2-.5-.5s.2-.5.5-.5h2.6c.3 0 .5.2.5.5 0 .2-.1.4-.2.6l-2.3 3h2c.3 0 .5.2.5.5s-.2.6-.5.6zm3 0c0 .3-.2.5-.5.5s-.5-.2-.5-.5V8.8c0-.3.2-.5.5-.5s.5.2.5.5v4.7zm5.3 0c0 .3-.2.5-.5.5-.2 0-.3-.1-.4-.2-.4.2-.8.3-1.2.3-1.3 0-2.4-1.1-2.4-2.4s1.1-2.4 2.4-2.4c.4 0 .8.1 1.2.3.1-.1.2-.2.4-.2.3 0 .5.2.5.5v3.6zm2.7.5c-.3 0-.5-.2-.5-.5V8.8c0-.3.2-.5.5-.5s.5.2.5.5v4.7c0 .3-.2.5-.5.5zm-4.4-3.6c-.7 0-1.3.6-1.3 1.3s.6 1.3 1.3 1.3 1.3-.6 1.3-1.3-.6-1.3-1.3-1.3z"/></svg>
      </a>
    </div>
    <p>© 2026 {{ thongtin.ten }} · {{ thongtin.dia_chi }} · {{ thongtin.dien_thoai }}</p>
  </footer>

  <div class="float-actions">
    <a href="{{ thongtin.zalo }}" target="_blank" rel="noopener" class="fab fab-zalo" aria-label="Nhắn Zalo">Zalo</a>
    <a href="tel:{{ thongtin.dien_thoai_goi }}" class="fab fab-phone" aria-label="Gọi đặt bàn">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
    </a>
  </div>

  <nav class="quickbar" aria-label="Liên hệ nhanh">
    <a href="tel:{{ thongtin.dien_thoai_goi }}">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
      Gọi
    </a>
    <a href="{{ thongtin.zalo }}" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C7 3 3 6.6 3 11c0 2.4 1.2 4.5 3.1 6-.1.7-.5 2-1.3 3-.2.2 0 .5.3.5 1.7-.3 3.2-1 4-1.6.9.2 1.9.3 2.9.3 5 0 9-3.6 9-8.1S17 3 12 3z"/></svg>
      Zalo
    </a>
    <a href="{{ thongtin.maps }}" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
      Chỉ đường
    </a>
    <a href="/#dat-ban" class="qb-main">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 3h-1V1h-2v2H10V1H8v2H7c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H7V9h10v10z"/></svg>
      ĐẶT BÀN
    </a>
  </nav>
  {% endif %}

  <script>
    (function () {
      var t = document.getElementById('nav-toggle');
      var l = document.getElementById('nav-links');
      if (t && l) {
        t.addEventListener('click', function () {
          var open = l.classList.toggle('open');
          t.setAttribute('aria-expanded', open ? 'true' : 'false');
          t.classList.toggle('active', open);
        });
      }
      // Hiệu ứng hiện dần khi cuộn trang
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.12 });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
      } else {
        document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
      }
    })();
  </script>

</body>
</html>
