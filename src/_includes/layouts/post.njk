---
layout: layouts/base.njk
og_type: article
---

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  "description": {{ mo_ta | dump | safe }},
  "image": "{{ thongtin.site_url }}{{ anh_dai_dien or '/hero.jpg' }}",
  "datePublished": "{{ page.date.toISOString() }}",
  "author": { "@type": "Organization", "name": "{{ thongtin.ten }}" },
  "publisher": { "@type": "Organization", "name": "{{ thongtin.ten }}", "logo": { "@type": "ImageObject", "url": "{{ thongtin.site_url }}/favicon.svg" } },
  "mainEntityOfPage": "{{ thongtin.site_url }}{{ page.url }}"
}
</script>

<article>
  <div class="post-hero">
    <div class="date">{{ page.date | ngayChu }}</div>
    <h1>{{ title }}</h1>
  </div>
  {% if anh_dai_dien %}
  <div class="container" style="max-width:860px; margin-top:-30px;">
    <img src="{{ anh_dai_dien }}" alt="{{ title }}" style="border-radius:18px; box-shadow:0 18px 40px rgba(11,79,108,.18); width:100%; max-height:440px; object-fit:cover;">
  </div>
  {% endif %}
  <div class="post-body">
    {{ content | safe }}
  </div>
  <div class="post-back">
    <a href="/tin-tuc/" class="btn btn-ghost" style="border-color:#1b9aaa; color:#0b4f6c;">← Xem tin khác</a>
  </div>
</article>
