---
layout: layouts/base.njk
---

<article>
  <div class="post-hero">
    <div class="date">{{ page.date | ngayChu }}</div>
    <h1>{{ title }}</h1>
  </div>
  {% if anh_dai_dien %}
  <div class="container" style="max-width:860px; margin-top:-30px;">
    <img src="{{ anh_dai_dien }}" alt="{{ title }}" style="border-radius:18px; box-shadow:0 18px 40px rgba(11,79,108,.18); width:100%; max-height:440px; object-fit:cover;">
  </div>
  {% endif %}
  <div class="post-body">
    {{ content | safe }}
  </div>
  <div class="post-back">
    <a href="/tin-tuc/" class="btn btn-ghost" style="border-color:#1b9aaa; color:#0b4f6c;">← Xem tin khác</a>
  </div>
</article>
